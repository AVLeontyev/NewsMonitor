{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=newsmonitor;Username=postgres;Password=postgres;SSL Mode=Disable;"
  },
  "Elasticsearch": {
    "Uri": "http://elasticsearch:9200",
    "IndexFormat": "newsmonitor-api-{0:yyyy.MM.dd}"
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": "5672",
    "Username": "newsuser",
    "Password": "newspassword",
    "VirtualHost": "newsmonitor"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}