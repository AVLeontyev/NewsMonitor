{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Port=5432;Database=newsmonitor;User Id=postgres;Password=postgres;SSL Mode=Disable;"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexFormat": "newsmonitor-api-{0:yyyy.MM.dd}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}