{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Port=5432;Database=newsmonitor;User Id=postgres;Password=postgres;SSL Mode=Disable;"
  },
  "JwtSettings": {
    "Secret": "your-super-secret-key-with-at-least-32-characters-here",
    "ExpiryMinutes": 60,
    "Issuer": "NewsMonitor",
    "Audience": "NewsMonitorUsers"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "newsuser",
    "Password": "newspassword",
    "VirtualHost": "newsmonitor"
  },
  "Hangfire": {
    "ConnectionString": "Server=127.0.0.1;Port=5432;Database=newsmonitor;User Id=postgres;Password=postgres;SSL Mode=Disable;"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexFormat": "newsmonitor-{0:yyyy.MM}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}